# ===========================================
# Pharmacy OS Backend - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Server Configuration
PORT=8080
APP_ENV=development  # development, staging, production
LOG_LEVEL=info      # debug, info, warn, error

# Database (PostgreSQL via Supabase/Supavisor)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres

# Go-managed authentication
# Supabase is only the PostgreSQL provider; it is not used for auth.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Brevo transactional email
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Pharmacy OS
PUBLIC_APP_URL=http://localhost:3000

# River Queue (Postgres-based job queue)
# Usually same as DATABASE_URL
RIVER_DSN=postgresql://postgres:postgres@localhost:6543/postgres

# CORS Configuration (comma-separated exact origins, no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Initial platform administrator (production bootstrap only)
# Keep the password in Replit Secrets, never commit it to this file.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Mohamed
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin
BOOTSTRAP_SUPER_ADMIN_COMPANY=Pharmacy OS

# Max Request Body Size (in bytes, default: 10MB)
MAX_REQUEST_SIZE=10485760

# ===========================================
# Paymob payments (Phase G) — leave empty until credentials arrive.
# Backend (DockHosting) only. Never in Vercel, never NEXT_PUBLIC_*,
# never committed. Full guide: docs/deployment.md section 6.
# ===========================================
# REQUIRED 1: "Secret Key" field — Dashboard → Settings → API Keys → View
#   (NOT the "API Key" field; this one authenticates the Intention API:
#    Authorization: Token <SECRET_KEY> — literal word Token, not Bearer)
PAYMOB_SECRET_KEY=
# REQUIRED 2: "Public Key" field — same page (pk_test_... / pk_live_...)
PAYMOB_PUBLIC_KEY=
# REQUIRED 3: "HMAC Secret" field — same page, used to verify webhooks
PAYMOB_HMAC_SECRET=
# REQUIRED 4: numeric Integration IDs — Dashboard → Settings → Payment
#   Integrations → ID column (Test and Live IDs exist per channel; must
#   match the key mode)
PAYMOB_CARD_INTEGRATION_ID=
# OPTIONAL: Mobile Wallets channel (Vodafone Cash etc.), same page
PAYMOB_WALLET_INTEGRATION_ID=
# NOT from Paymob — you generate it: openssl rand -hex 32
PAYMOB_WEBHOOK_TOKEN=
# OPTIONAL (leave empty): dashboard "API Key" field — only for the future
# Transaction Inquiry fallback, unused today
PAYMOB_API_KEY=
# OPTIONAL (leave empty): API base override, default https://accept.paymob.com
PAYMOB_BASE_URL=
