modules = ["go-1.21", "nodejs-20", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "exec ./pharmacy-api"]
build = ["sh", "-c", "cd backend && GOTOOLCHAIN=auto GOSUMDB=sum.golang.org GOPROXY=https://proxy.golang.org,direct GOFLAGS=-mod=vendor CGO_ENABLED=0 go build -o ../pharmacy-api ./cmd/server"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Admin Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend/apps/admin-dashboard && NEXT_PUBLIC_API_URL=/api/v1 npm run dev -- -p 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Marketing Site"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend/apps/marketing && npm run dev -- -p 5002"
waitForPort = 5002

[[workflows.workflow]]
name = "Pharmacy App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend/apps/pharmacy-app && NEXT_PUBLIC_API_URL=/api/v1 npm run dev -- -p 5001"
waitForPort = 5001

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && GOTOOLCHAIN=auto GOSUMDB=sum.golang.org GOPROXY=https://proxy.golang.org,direct GOFLAGS=-mod=vendor go run ./cmd/server"
waitForPort = 8080

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin Dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pharmacy App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Marketing Site"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3000

[[ports]]
localPort = 5003
externalPort = 3003

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.production]
APP_ENV = "production"
AUTH_COOKIE_SECURE = "true"
CORS_ORIGINS = "https://pharmacy-app-theta-nine.vercel.app,https://admin-dashboard-swart-two-41.vercel.app"
PUBLIC_APP_URL = "https://pharmacy-app-theta-nine.vercel.app"
BOOTSTRAP_SUPER_ADMIN_COMPANY = "Pharmacy OS"
BOOTSTRAP_SUPER_ADMIN_EMAIL = "zyyat@outlook.sa"
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME = "Mohamed"
BOOTSTRAP_SUPER_ADMIN_LAST_NAME = "Admin"

[userenv.shared]
MAIL_FROM_EMAIL = "zayat2349@gmail.com"

[userenv.development]
PUBLIC_APP_URL = "https://8e9ec9ec-bf3b-4a07-9d73-7f9be3fe24cd-00-3nm9q5b3j8293.kirk.replit.dev:3000"
