# Supabase Configuration (shared by all apps)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Configuration
# In Vercel/Render production, use the public backend URL including /api/v1.
# In Replit development, keep /api/v1 and let next.config.js proxy locally.
# Replit/local development uses the Next.js proxy:
NEXT_PUBLIC_API_URL=/api/v1
# Optional server-side proxy target. Only needed when the frontend uses /api/v1.
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_PHARMACY_APP_URL=http://localhost:5001

# App Configuration
NEXT_PUBLIC_APP_NAME=Pharmacy OS
