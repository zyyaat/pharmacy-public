# ============================================================================
# Frontend environment variables (Vercel -> Project Settings -> Environment)
# ============================================================================
# Two mutually exclusive ways to connect the app to the Go backend.
# Pick ONE per app. If both are set, NEXT_PUBLIC_API_URL wins in the browser.

# --- Option A (recommended): direct mode (browser -> backend) ---------------
# MUST end with /api/v1 because the client appends /auth/login etc. directly.
# Requires CORS_ORIGINS on DockHosting to include this Vercel domain.
# NEXT_PUBLIC_API_URL=https://pharmacyos.dockhosting.dev/api/v1

# --- Option B: proxy mode (browser -> same-origin -> backend) ---------------
# Leave NEXT_PUBLIC_API_URL EMPTY and set this instead. The Next.js rewrite
# proxies /api/v1/* and /health to the backend server-side, so cookies are
# first-party and CORS is irrelevant. Do NOT add /api/v1 here.
# BACKEND_URL=https://pharmacyos.dockhosting.dev

# --- Local development ------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# (or leave unset and run the backend on 127.0.0.1:8080 with the proxy)

# App Configuration
NEXT_PUBLIC_APP_NAME=Pharmacy OS
