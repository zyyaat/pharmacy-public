; Pharmacy OS — ترجمة عربية لمعالج التثبيت (Inno Setup 6)
; المفاتيح غير الموجودة هنا تسقط تلقائيًا للإنجليزية في Default.isl.

[LangOptions]
LanguageName=العربية
LanguageID=$0401
DialogFontName=Segoe UI
DialogFontSize=9
WelcomeFontName=Segoe UI
WelcomeFontSize=12
TitleFontName=Segoe UI
TitleFontSize=29

[Messages]
; — عناوين النوافذ —
SetupAppTitle=إعداد [name]
SetupWindowTitle=إعداد {#AppName}

; — الأزرار —
ButtonBack=< &رجوع
ButtonNext=&التالي >
ButtonInstall=&تثبيت
ButtonOK=موافق
ButtonCancel=إلغاء
ButtonYes=&نعم
ButtonNo=&لا
ButtonBrowse=&استعراض...
ButtonFinish=&إنهاء

; — شاشة الترحيب —
WelcomeLabel1=مرحبًا بك في معالج تثبيت [name]
WelcomeLabel2=سيُثبّت هذا المعالج [name/ver] على حاسوبك.%n%nيُنصح بإغلاق كل التطبيقات الأخرى قبل المتابعة.%n%nاضغط «التالي» للمتابعة.

; — اختيار مجلد التثبيت —
SelectDirDesc=أين يجب تثبيت [name]؟
SelectDirLabel3=سيُثبَّت [name] في المجلد التالي.
SelectDirBrowseLabel=للمتابعة اضغط «التثبيت». لتغيير المجلد اضغط «استعراض».
SelectDirBrowseLabel2=للمتابعة اضغط «التالي». لتغيير المجلد اضغط «استعراض».
dirDoesntExistTitle=المجلد غير موجود
dirDoesntExistMessage=المجلد:%n%n%s%n%nغير موجود. هل تريد إنشاءه؟

; — مجلد قائمة ابدأ —
SelectStartMenuFolderDesc=أين يجب وضع اختصارات البرنامج؟
SelectStartMenuFolderLabel=سيُنشئ المعالج اختصارات البرنامج في مجلد قائمة ابدأ التالي.
SelectStartMenuFolderBrowseLabel=للمتابعة اضغط «التالي».

; — مهام إضافية —
SelectTasksDesc=أي المهام الإضافية تريد تنفيذها؟
SelectTasksLabel2=اختر المهام الإضافية التي ينبغي للمعالج تنفيذها أثناء تثبيت [name]، ثم اضغط «التالي».
CreateDesktopIcon=إنشاء اختصار على &سطح المكتب
AdditionalIcons=مهام إضافية:

; — جاهز للتثبيت —
ReadyLabel1=جاهز للتثبيت
ReadyLabel2a=اضغط «تثبيت» لبدء التثبيت.
ReadyLabel2b=راجع الإعدادات أعلاه ثم اضغط «تثبيت» لبدء التثبيت.

; — أثناء التثبيت —
InstallingLabel=جارٍ تثبيت [name]، انتظر لحظة…
StatusExtracting=جارٍ فك الملفات…
StatusClosingApplications=جارٍ إغلاق التطبيقات…
StatusRestartingApplications=جارٍ إعادة تشغيل التطبيقات…

; — الانتهاء —
FinishedHeadingLabel=اكتمل تثبيت [name]
FinishedLabelNoIcons=تم تثبيت [name] على حاسوبك بنجاح.
FinishedLabel=تم تثبيت [name] على حاسوبك بنجاح.%n%nيمكن تشغيل التطبيق من الاختصار المُنشأ.
ClickFinish=اضغط «إنهاء» لإنهاء المعالج.
LaunchProgram=تشغيل [name]

; — الخروج من المعالج —
ExitSetupTitle=إنهاء المعالج
ExitSetupMessage=لم يكتمل التثبيت بعد.%n%nإن خرجت الآن سيتعين عليك تشغيل المعالج مرة أخرى لاحقًا.%n%nهل تريد الخروج؟

; — رسائل عامة —
SetupIsRunningMessage=معالج التثبيت يعمل بالفعل — أكمله أولًا.
ErrorChangingDir=تعذر تغيير المجلد.
YouMustSelectADirectory=يجب اختيار مجلد.
InvalidPath=مسار غير صالح
BrowseDialogLabel=اختر مجلدًا ثم اضغط موافق.
NotOnFloppyDrive=لا يمكن التثبيت على محرك أقراص مرنة.
WaitingSharedFileTitle=مشاركة ملف
BrowseDialogTitle=استعراض المجلد
UninstallAppTitle=إزالة [name]
UninstallAppFullTitle=إزالة %1
UninstallStatusLabel=جارٍ إزالة %1، انتظر لحظة…
UninstalledAllSubCaption=اكتملت الإزالة.
UninstallDataFileNotFound=ملف الإزالة غير موجود — لا يمكن إزالة البرنامج.
UninstallOpenError=تعذر فتح ملف الإزالة.
UninstallVerify=هل تريد بالتأكيد إزالة %1 وكل مكوناته؟
